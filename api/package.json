{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "vite build",
    "preview": "bash scripts/preview.sh",
    "prepare": "svelte-kit sync || echo ''",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integrated.test.js'",
    "test:integration": "vitest run .integrated.test.js",
    "test:e2e": "vite build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "get-port": "^7.2.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "vite": "^8.0.7",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "cookie-es": "^3.1.1",
    "jsdom": "^30.0.1",
    "lucide-svelte": "^1.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "ws": "^8.21.1"
  }
}
