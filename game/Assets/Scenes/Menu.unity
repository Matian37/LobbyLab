  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Przemierzaj przestworza razem z ptakiem frunacym przed siebie. W rytm
    muzyki steruj nim i uderzaj w chmurki, aby ten czerpal z nich moc do dalszego
    lotu!

    Odkrywaj podniebny swiat przechodzac kolejne piosenki ukryte w chmurkach
    na mapie! Kazde przejscie piosenki daje ci jedno piorko i 300 BeatCoin. Dodatkowo
    kazde uderzenie chmurki daje ci 1 BeatCoin. Za piorka mozesz odblokowywac kolejne
    poziomy! Za BeatCoiny mozesz kupic piorka w menu glownym lub wykorzystac je do
    konfiguracji twojego ptaszka. Mozesz wykonywac zadania dzienne oferujace nagrody
    w postaci BeatCoinow. '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cba92c57aa6b16144beb5c2a08372ce6, type: 2}
